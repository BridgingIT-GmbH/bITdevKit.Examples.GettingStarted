@using BridgingIT.DevKit.Examples.GettingStarted.Modules.CoreModule.Application
@using BridgingIT.DevKit.Examples.GettingStarted.Modules.CoreModule.Infrastructure.EntityFramework
@inherits DashboardContentSlice

@{
    var viewModel = await CreateModelAsync();
}

@if (viewModel.Errors.Count > 0)
{
    <div class="alert alert-danger py-2 mb-2">
        @foreach (var error in viewModel.Errors)
        {
            <div>@error</div>
        }
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body p-3">
            <div class="text-muted small">Customers</div>
            <div class="fs-4 fw-semibold">@viewModel.Customers.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body p-3">
            <div class="text-muted small">Active</div>
            <div class="fs-4 fw-semibold">@viewModel.ActiveCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body p-3">
            <div class="text-muted small">Leads</div>
            <div class="fs-4 fw-semibold">@viewModel.LeadCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body p-3">
            <div class="text-muted small">Retired</div>
            <div class="fs-4 fw-semibold">@viewModel.RetiredCount</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title mb-0">Customer records</h6>
            <span class="badge text-bg-secondary">@viewModel.Customers.Count</span>
        </div>

        @if (viewModel.Customers.Count == 0)
        {
            <div class="text-muted small">No customers are available.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Date of birth</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var customer in viewModel.Customers)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@customer.FirstName @customer.LastName</div>
                                <div class="text-muted small">@DisplayValue(customer.Number)</div>
                            </td>
                            <td class="text-break">@DisplayValue(customer.Email)</td>
                            <td><span class="badge @StatusBadge(customer.Status)">@DisplayValue(customer.Status)</span></td>
                            <td>@(customer.DateOfBirth?.ToString("d", CultureInfo.CurrentCulture) ?? "-")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            data-customer-edit="@JsonSerializer.Serialize(customer, BridgingIT.DevKit.Common.DefaultJsonSerializerOptions.Create())">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            data-customer-delete="@customer.Id"
                                            data-customer-name="@customer.FirstName @customer.LastName">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private async Task<CustomerManagementModel> CreateModelAsync()
    {
        var result = new CustomerManagementModel();
        var databaseReadyService = this.HttpContext.RequestServices.GetService<IDatabaseReadyService>();
        if (databaseReadyService?.IsReady(nameof(CoreModuleDbContext)) == false)
        {
            result.Errors.Add("The database is still starting.");
            return result;
        }

        var requester = this.HttpContext.RequestServices.GetService<IRequester>();
        if (requester is null)
        {
            result.Errors.Add("The requester service is not registered.");
            return result;
        }

        var customers = await requester.SendAsync(
            new CustomerFindAllQuery { Filter = new FilterModel() },
            cancellationToken: this.HttpContext.RequestAborted);
        if (customers.IsFailure)
        {
            result.Errors.AddRange(customers.Errors.Select(error => error.Message));
            return result;
        }

        result.Customers.AddRange(customers.Value
            .OrderBy(customer => customer.LastName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(customer => customer.FirstName, StringComparer.OrdinalIgnoreCase));
        return result;
    }

    private static string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string StatusBadge(string status) => status switch
    {
        "Active" => "text-bg-success",
        "Retired" => "text-bg-secondary",
        _ => "text-bg-info"
    };

    private sealed class CustomerManagementModel
    {
        public List<CustomerModel> Customers { get; } = [];

        public List<string> Errors { get; } = [];

        public int ActiveCount => this.Customers.Count(customer => customer.Status == "Active");

        public int LeadCount => this.Customers.Count(customer => customer.Status == "Lead");

        public int RetiredCount => this.Customers.Count(customer => customer.Status == "Retired");
    }
}
