{
  "mcpServers": {
    "ado": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${ADO_ORG}"
      ]
    },
    "bdk": {
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "bdk",
        "mcp",
        "--toolset",
        "diagnostics,operations,admin"
      ]
    }
  }
}