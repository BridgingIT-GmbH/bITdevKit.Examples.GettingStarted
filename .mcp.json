{
  "servers": {
    "ado": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@azure-devops/mcp",
				"${input:ado_org}"
			]
		}
  },
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Azure DevOps organization name  (e.g. 'bitdevelopment')"
    }
  ],
  "bdk": {
    "type": "local",
    "command": "dotnet",
    "args": [
      "tool",
      "run",
      "bdk",
      "mcp",
      "--toolset",
      "diagnostics,operations,admin"
    ],
    "tools": [
      "*"
    ]
  }
}